;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; DAAL DESELECTIONS ;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;
; deselect daal::internal namespaces

[suppress_type]
symbol_name_regexp = _Z+.*4daal[[:digit:]].*8internal[[:digit:]].*
drop = yes

[suppress_variable]
symbol_name_regexp = _Z+.*4daal[[:digit:]].*8internal[[:digit:]].*
drop = yes

[suppress_function]
symbol_name_regexp = _Z+.*4daal[[:digit:]].*8internal[[:digit:]].*
drop = yes

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; DAAL THREADING LAYER DESELECTIONS ;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; deselect the loop entry points of the threading layer
;
; These are exported from libonedal_thread only, with C linkage, and no installed header
; declares them: nothing outside the libraries that ship alongside libonedal_thread can hold a
; reference to them, so their signatures and their set of names are not part of the product ABI.
; The oneDAL-level wrappers in oneapi/dal/detail/threading.hpp -- the _onedal_threader_* family,
; which an application's own object files *can* reference -- are deliberately not deselected
; here.
;
; A regexp rather than one entry per symbol, so that adding a loop entry point does not also
; mean editing this file.

[suppress_function]
symbol_name_regexp = ^_daal_(static_)?threader_for.*
drop = yes

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; KERNEL PROFILER DESELECTIONS ;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; deselect the profiler entry points that only the oneDAL libraries call
;
; No installed header declares daal::internal::profiler_* or _daal_threader_set_profiler_hooks.
; The documented C entry point _onedal_profiler_report is deliberately not deselected.

[suppress_function]
symbol_name_regexp = ^(_ZN4daal8internal[[:digit:]]+profiler_|_daal_threader_set_profiler_hooks$)
drop = yes

; std::vector<std::string> members instantiated by the previous profiler header. An implicit
; instantiation of a std template is emitted by every object file that uses it, so no caller
; depends on the libraries providing it.

[suppress_function]
symbol_name_regexp = ^_ZNSt6vectorINSt7__cxx1112basic_stringIcSt11char_traitsIcESaIcEEESaIS5_EE
change_kind = deleted-function
drop = yes

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; DAAL 2026.0 REMOVALS ;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; deselect the removed daal symbols

;[suppress_type]
;symbol_name_regexp = _Z+N4daal[[:digit:]].*
;change_kind = deleted-type
;drop = yes

;[suppress_variable]
;symbol_name_regexp = _Z+N4daal[[:digit:]].*
;change_kind = deleted-variable
;drop = yes

;[suppress_function]
;symbol_name_regexp = _Z+N4daal[[:digit:]].*
;change_kind = deleted-function
;drop = yes

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;; oneDAL DESELECTIONS ;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; deselect oneapi::dal backend namespaces
[suppress_type]
symbol_name_regexp = _Z+N6oneapi3dal[[:digit:]].*7backend[[:digit:]].*
drop = yes

[suppress_variable]
symbol_name_regexp = _Z+N6oneapi3dal[[:digit:]].*7backend[[:digit:]].*
drop = yes

[suppress_function]
symbol_name_regexp = _Z+N6oneapi3dal[[:digit:]].*7backend[[:digit:]].*
drop = yes

; deselect oneapi::dal detail namespaces
[suppress_type]
symbol_name_regexp = _Z+N6oneapi3dal[[:digit:]].*6detail[[:digit:]].*
drop = yes

[suppress_variable]
symbol_name_regexp = _Z+N6oneapi3dal[[:digit:]].*6detail[[:digit:]].*
drop = yes

[suppress_function]
symbol_name_regexp = _Z+N6oneapi3dal[[:digit:]].*6detail[[:digit:]].*
drop = yes

; deselect oneapi::dal preview namespaces
[suppress_type]
symbol_name_regexp = _Z+N6oneapi3dal[[:digit:]].*7preview[[:digit:]].*
drop = yes

[suppress_variable]
symbol_name_regexp = _Z+N6oneapi3dal[[:digit:]].*7preview[[:digit:]].*
drop = yes

[suppress_function]
symbol_name_regexp = _Z+N6oneapi3dal[[:digit:]].*7preview[[:digit:]].*
drop = yes

; deselect oneapi::dal newly added symbols
[suppress_type]
symbol_name_regexp = _Z[ZT]?[ISV]?N6oneapi3dal[[:digit:]].*
change_kind = added-type
drop = yes

[suppress_variable]
symbol_name_regexp = _Z[ZT]?[ISV]?N6oneapi3dal[[:digit:]].*
change_kind = added-variable
drop = yes

[suppress_function]
symbol_name_regexp = _Z[ZT]?[ISV]?N6oneapi3dal[[:digit:]].*
change_kind = added-function
drop = yes
